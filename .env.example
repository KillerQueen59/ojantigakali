# Strava — "On the run" panel (About Me). Single-athlete, server-side only.
# 1. Create an app at https://www.strava.com/settings/api  → get Client ID + Secret.
# 2. Do a one-time OAuth with scope "read,activity:read_all" and exchange the
#    returned code for a refresh token (see docs/strava-setup below or ask).
# 3. Put the real values in .env.local (git-ignored). Never commit secrets.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Portfolio API (Go backend, ojantigakali-api). Serves portfolio content and the
# farm card catalog. Local dev default is http://localhost:8080.
NEXT_PUBLIC_JOURNAL_API_URL=http://localhost:8080

# Farmhouse "MY CRITTER" pets. By default only the hamster is unlocked; the rest
# are "coming soon". Set to true (or 1) to unlock all critters. Build-time flag.
NEXT_PUBLIC_FARM_UNLOCK_CRITTERS=true
